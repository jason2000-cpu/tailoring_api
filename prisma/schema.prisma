// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  USER
}

enum CompletionStatus {
  Complete
  InProgress
  Pending
}

model Users {
  id                Int                  @id @default(autoincrement())
  Fname             String
  Sname             String
  email             String               @unique
  role              Role
  phone             String?
  profile_url       String?
  accountStatus     Boolean             @default(true)
  notifications     Notifications[]
  events            Events[]            @relation("UserEvents")
  business          Businesses?         @relation("BusinessOwner")
  password          String
}

model Businesses {
  id                 Int                  @id @default(autoincrement())
  name               String               @default("Santiago Tailoring")
  email              String               @default("santiagotailoring@gmail.com")
  phone              String               @default("+254797955092")
  address            String               @default("Nairobi, Kenya")
  currency           String               @default("Ksh")
  logo               String?
  userId             Int                  @unique
  user               Users                @relation("BusinessOwner", fields: [userId], references: [id], onDelete: Cascade)
  clients            Clients[]            @relation("BusinessClients")
  orders             Orders[]             @relation("BusinessOrders")
  financialRecords   FinancialRecord[]    @relation("BusinessFinancialRecords")
  income             Income[]             @relation("BusinessIncome")
  expenses           Expenses[]           @relation("BusinessExpenses")
}


model Clients {
  id                 Int                 @id @default(autoincrement())
  Fname              String
  Sname              String
  email              String?
  phone              String              @unique
  businessId         Int
  activeOrder        Boolean             @default(false)
  business           Businesses          @relation("BusinessClients", fields: [businessId], references: [id], onDelete: Cascade)
  measurements       Measurements?       @relation("ClientMeasurements")
  orders             Orders[]            @relation("ClientOrders")
}

model Notifications {
  id              Int         @id  @default(autoincrement())
  userId          Int
  user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  read            Boolean
  type            String
  message         String
}

model Measurements {
  id              Int         @id  @default(autoincrement())
  clientId        Int         @unique
  client          Clients     @relation("ClientMeasurements", fields: [clientId], references: [id], onDelete: Cascade)
  height          String
  shoulders       String
  hand            String
  chest           String
  waist           String
  hips            String
}


model Orders {
  id                   Int                @id   @default(autoincrement())
  item                 String
  description          String?
  collectionDate       DateTime
  completionStatus     CompletionStatus   @default(InProgress)
  businessId           Int
  business             Businesses         @relation("BusinessOrders", fields: [businessId], references: [id], onDelete: Cascade)
  clientId             Int
  client               Clients            @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  payments             Payments?          @relation("OrderPayment")
}

model Payments {
  id              Int         @id @default(autoincrement())
  orderId         Int         @unique
  order           Orders      @relation("OrderPayment", fields: [orderId], references: [id], onDelete: Cascade)
  paidAmount      Float
  totalAmount     Float
  createdAt       DateTime    @default(now())
}

model Income {
  id                  Int             @id  @default(autoincrement())
  amount              Float
  businessId          Int
  business            Businesses      @relation("BusinessIncome", fields: [businessId], references: [id], onDelete: Cascade)
  description         String
  createdAt           DateTime        @default(dbgenerated("date_trunc('day', now())")) @db.Timestamptz
  category            String
}

model Expenses {
  id                  Int              @id  @default(autoincrement())
  amount              Float
  businessId          Int
  business            Businesses       @relation("BusinessExpenses", fields: [businessId], references: [id], onDelete: Cascade)
  description         String
  createdAt           DateTime         @default(dbgenerated("date_trunc('day', now())")) @db.Timestamptz
  category            String
}

model FinancialRecord {
  id                  Int              @id  @default(autoincrement())
  businessId          Int
  business            Businesses       @relation("BusinessFinancialRecords", fields: [businessId], references: [id], onDelete: Cascade )
  date                DateTime
  income              Float            @default(0)
  expenses            Float            @default(0)
  profit              Float            @default(0)
  createdAt           DateTime         @default(dbgenerated("date_trunc('day', now())")) @db.Timestamptz
  updatedAt           DateTime         @updatedAt

  @@unique([businessId, date])
}

model Events {
  id                Int          @id  @default(autoincrement())
  title             String
  start             DateTime
  end               DateTime
  description       String?
  userId            Int
  user              Users        @relation("UserEvents", fields:[userId], references: [id], onDelete: Cascade)
}
